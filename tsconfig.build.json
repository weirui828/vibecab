{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "contract/src/**/*.ts",
    "contract/generated/**/*.ts",
    "engine/src/**/*.ts",
    "adapters/*/src/**/*.ts",
    "host/src/**/*.ts",
    "apps/macos/src/**/*.ts",
    "apps/web/server/**/*.ts"
  ]
}
