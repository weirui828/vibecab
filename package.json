{
  "name": "vibecab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:prop": "FC_NUM_RUNS=1000 vitest run engine/test/properties",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "test:build": "pnpm build && node scripts/smoke-built.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "node": "22.22.0"
  }
}
