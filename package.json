{
  "name": "vibecab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter @vibecab/lint lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:prop": "FC_NUM_RUNS=1000 vitest run engine/test/properties",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "test:build": "pnpm build && node scripts/smoke-built.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "node": "26.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
