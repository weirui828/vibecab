{
  "name": "vibecab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter @vibecab/lint lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:prop": "FC_NUM_RUNS=1000 vitest run engine/test/properties",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs && pnpm --filter @vibecab/ui build && pnpm --filter @vibecab/web build",
    "test:build": "pnpm build && node scripts/smoke-built.mjs",
    "app:dev": "node apps/macos/dev.mjs",
    "test:e2e": "pnpm build && pnpm --filter @vibecab/macos test:e2e",
    "app:package": "node apps/macos/scripts/package-macos.mjs",
    "app:smoke": "node apps/macos/scripts/smoke-packaged.mjs",
    "web": "pnpm build && node apps/web/bin/vibecab-web.mjs",
    "web:dev": "tsc -p tsconfig.build.json && VIBECAB_DEV=1 node apps/web/bin/vibecab-web.mjs --dev --temp-workspace --fake-provider apps/web/dev/fake-provider.json --seed"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "node": "26.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
