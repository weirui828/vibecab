{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/provider-model.json",
  "title": "ProviderModel",
  "type": "object",
  "properties": {
    "provider": {
      "enum": ["openai-compatible", "claude-agent-sdk", "codex-sdk"],
      "description": "openai-compatible: an HTTP model API. claude-agent-sdk / codex-sdk: Claude Code or Codex on this computer, through its SDK and its own sign-in; such models are priced 0 here."
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "keyRef": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "jsonSchemaOutput": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "reportsUsage": {
          "type": "boolean"
        }
      },
      "required": ["tools", "jsonSchemaOutput", "streaming", "maxContextTokens", "reportsUsage"],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "inputMicrosPerMillion": {
          "type": "integer",
          "minimum": 0
        },
        "outputMicrosPerMillion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["inputMicrosPerMillion", "outputMicrosPerMillion"],
      "additionalProperties": false
    },
    "catalogProvider": {
      "type": "string",
      "minLength": 1,
      "description": "The built-in provider (catalog id) this model was chosen from, if any."
    },
    "pricingSource": {
      "enum": ["catalog", "live", "custom"],
      "description": "Where the price came from: the built-in catalog, a provider's live list, or the person."
    }
  },
  "required": ["provider", "baseUrl", "model", "capabilities", "pricing"],
  "additionalProperties": false
}
