{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/provider-model.json",
  "title": "ProviderModel",
  "type": "object",
  "properties": {
    "provider": { "const": "openai-compatible" },
    "baseUrl": { "type": "string", "format": "uri" },
    "model": { "type": "string", "minLength": 1 },
    "keyRef": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": { "type": "boolean" },
        "jsonSchemaOutput": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "maxContextTokens": { "type": "integer", "minimum": 1 },
        "reportsUsage": { "type": "boolean" }
      },
      "required": ["tools", "jsonSchemaOutput", "streaming", "maxContextTokens", "reportsUsage"],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "inputMicrosPerMillion": { "type": "integer", "minimum": 0 },
        "outputMicrosPerMillion": { "type": "integer", "minimum": 0 }
      },
      "required": ["inputMicrosPerMillion", "outputMicrosPerMillion"],
      "additionalProperties": false
    }
  },
  "required": ["provider", "baseUrl", "model", "capabilities", "pricing"],
  "additionalProperties": false
}
