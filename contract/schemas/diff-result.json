{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/diff-result.json",
  "title": "DiffResult",
  "type": "object",
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "moved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "textDiffs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "added": {
              "type": "boolean"
            },
            "removed": {
              "type": "boolean"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "added",
    "removed",
    "changed",
    "moved",
    "textDiffs"
  ],
  "additionalProperties": false
}
