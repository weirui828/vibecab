{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/settings.json",
  "title": "Settings",
  "type": "object",
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://vibecab.local/schemas/provider-model.json"
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "localTimeZone": {
          "type": "string",
          "minLength": 1
        },
        "defaultTurnLimitMicros": {
          "type": "integer",
          "minimum": 0
        },
        "defaultTurnTokenLimit": {
          "type": "integer",
          "minimum": 1
        },
        "realtimeDebounceSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "toolCallLimit": {
          "type": "integer",
          "minimum": 1
        },
        "toolTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "toolResultByteLimit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://vibecab.local/schemas/session-settings.json"
      }
    },
    "trashRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "roles": {
      "$ref": "https://vibecab.local/schemas/roles.json"
    }
  },
  "required": ["models", "budgets", "sessions"],
  "additionalProperties": false
}
