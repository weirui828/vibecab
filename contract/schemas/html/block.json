{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/html/block.json",
  "title": "HtmlBlockElement",
  "type": "object",
  "properties": {
    "elementId": {
      "type": "string",
      "pattern": "^el_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "html_block"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "html": {
      "type": "string",
      "minLength": 1,
      "htmlElement": true
    }
  },
  "required": ["elementId", "type", "parentId", "order", "props", "html"],
  "additionalProperties": false
}
