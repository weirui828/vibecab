{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/doc/image.json",
  "title": "ImageElement",
  "type": "object",
  "properties": {
    "elementId": {
      "type": "string",
      "pattern": "^el_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "image"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "blobHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "elementId",
    "type",
    "parentId",
    "order",
    "props",
    "blobHash"
  ],
  "additionalProperties": false
}
