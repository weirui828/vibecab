{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/doc/heading.json",
  "title": "HeadingElement",
  "type": "object",
  "properties": {
    "elementId": {
      "type": "string",
      "pattern": "^el_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "heading"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "inlineText": true
    }
  },
  "required": [
    "elementId",
    "type",
    "parentId",
    "order",
    "props",
    "text"
  ],
  "additionalProperties": false
}
