{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/doc/callout.json",
  "title": "CalloutElement",
  "type": "object",
  "properties": {
    "elementId": {
      "type": "string",
      "pattern": "^el_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "callout"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "enum": ["info", "note", "warning"]
        }
      },
      "required": ["tone"],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "inlineText": true
    }
  },
  "required": ["elementId", "type", "parentId", "order", "props", "text"],
  "additionalProperties": false
}
