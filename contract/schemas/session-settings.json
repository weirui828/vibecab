{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/session-settings.json",
  "title": "SessionSettings",
  "type": "object",
  "properties": {
    "replyTrigger": { "enum": ["realtime", "batch", "manual"] },
    "tokenLimit": { "type": "integer", "minimum": 1 },
    "toolCallLimit": { "type": "integer", "minimum": 1 },
    "replyRateLimitPerHour": { "type": "integer", "minimum": 1 },
    "realtimeDebounceSeconds": { "type": "integer", "minimum": 1 },
    "batchCommentThreshold": { "type": "integer", "minimum": 1 },
    "batchIdleMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "agentProfile": { "type": "string" },
    "brief": { "type": "string" },
    "planReview": { "type": "boolean" },
    "directEditing": { "type": "boolean" },
    "holdIdleMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "updateIdleMinutes": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
