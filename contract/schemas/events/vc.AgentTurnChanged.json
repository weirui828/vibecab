{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/events/vc.AgentTurnChanged.json",
  "title": "AgentTurnChanged",
  "type": "object",
  "properties": {
    "turnId": { "type": "string" },
