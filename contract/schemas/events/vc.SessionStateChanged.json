{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/events/vc.SessionStateChanged.json",
  "title": "SessionStateChanged",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": ["active", "paused", "ended"]
    }
  },
  "required": ["sessionId", "state"],
  "additionalProperties": false
}
