{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/idea.json",
  "title": "Idea",
  "type": "object",
  "properties": {
    "ideaId": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "links": { "type": "array", "items": { "type": "string" } },
    "sessionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["ideaId", "text", "createdAt"],
  "additionalProperties": false
}
