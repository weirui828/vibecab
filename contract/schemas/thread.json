{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/thread.json",
  "title": "Thread",
  "type": "object",
  "properties": {
    "threadId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "https://vibecab.local/schemas/feedback-comment.json"
      },
      "minItems": 1
    },
    "anchorResolutions": {
      "type": "array",
      "items": {
        "$ref": "https://vibecab.local/schemas/anchor-resolution.json"
      }
    },
    "replyTrigger": {
      "$ref": "https://vibecab.local/schemas/reply-trigger.json"
    }
  },
  "required": ["threadId", "sessionId", "comments", "anchorResolutions"],
  "additionalProperties": false
}
