{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/command-result.json",
  "title": "CommandResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "https://vibecab.local/schemas/json.json"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ok",
        "result",
        "seq"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "https://vibecab.local/schemas/contract-error.json"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
