{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/principal.json",
  "title": "Principal",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "human"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "system"
        },
        "job": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "job"
      ],
      "additionalProperties": false
    }
  ]
}
