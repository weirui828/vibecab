{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/output-set.json",
  "title": "OutputSet",
  "type": "object",
  "properties": {
    "outputSetId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["artifactId", "version", "manifestHash"],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "agreementIds": { "type": "array", "items": { "type": "string" } },
        "reviewRequestIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["agreementIds", "reviewRequestIds"],
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["outputSetId", "members", "links", "createdAt"],
  "additionalProperties": false
}
