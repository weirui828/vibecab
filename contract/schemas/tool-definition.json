{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/tool-definition.json",
  "title": "ExternalToolDefinition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "annotations": {
      "type": "object",
      "properties": {
        "readOnlyHint": {
          "type": "boolean"
        },
        "destructiveHint": {
          "type": "boolean"
        },
        "idempotentHint": {
          "type": "boolean"
        },
        "openWorldHint": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["name", "inputSchema"]
}
