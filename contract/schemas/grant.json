{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/grant.json",
  "title": "Grant",
  "type": "object",
  "properties": {
    "grantId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "properties": {
        "sessionIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "artifactIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": ["auto_agree_own_proposals", "start_review", "create_output_set", "use_tool"]
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serverId": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "minLength": 1 }
        },
        "required": ["serverId", "tool"],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "spendMicros": { "type": "integer", "minimum": 0 },
        "maxReviews": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["grantId", "scope", "capabilities", "limits"],
  "additionalProperties": false
}
