{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/backup-manifest.json",
  "title": "BackupManifest",
  "type": "object",
  "properties": {
    "format": { "const": 1 },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(workspace\\.sqlite|blobs/[a-f0-9]{2}/[a-f0-9]{2}/[a-f0-9]{60}(\\.meta\\.json)?)$"
      },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "required": ["format", "files"],
  "additionalProperties": false
}
