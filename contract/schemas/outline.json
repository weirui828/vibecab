{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/outline.json",
  "title": "Outline",
  "type": "array",
  "items": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "list",
            "list_item",
            "quote",
            "code_block",
            "table",
            "table_row",
            "table_cell",
            "image",
            "divider",
            "callout"
          ]
        },
        "preview": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "elementId",
        "type",
        "preview",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
