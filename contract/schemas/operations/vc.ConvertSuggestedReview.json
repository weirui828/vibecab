{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.ConvertSuggestedReview.json",
  "title": "vcConvertSuggestedReviewOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "draftId": { "type": "string" },
        "question": { "type": "string", "minLength": 1 },
        "elementRefs": {
          "$ref": "https://vibecab.local/schemas/operations/vc.RequestReview.json#/properties/payload/properties/elementRefs"
        },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "preset": { "type": "string" },
        "participants": {
          "$ref": "https://vibecab.local/schemas/operations/vc.RequestReview.json#/properties/payload/properties/participants"
        },
        "limits": {
          "$ref": "https://vibecab.local/schemas/operations/vc.RequestReview.json#/properties/payload/properties/limits"
        },
        "mode": { "enum": ["live", "demo"] }
      },
      "required": ["draftId", "question", "elementRefs", "preset", "limits", "mode"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": { "reviewRequestId": { "type": "string" }, "status": { "type": "string" } },
      "required": ["reviewRequestId", "status"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.ConvertSuggestedReview",
    "kind": "command",
    "meta": { "effect": "collaborate", "irreversible": false, "channels": ["in_process", "http", "cli"] }
  }
}
