{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Outline.json",
  "title": "vcOutlineOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["artifactId"],
      "additionalProperties": false
    },
    "result": {
      "$ref": "https://vibecab.local/schemas/outline.json"
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Outline",
    "kind": "query",
    "meta": {
      "effect": "read",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
