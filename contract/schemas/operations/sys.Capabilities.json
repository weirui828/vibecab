{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/sys.Capabilities.json",
  "title": "sysCapabilitiesOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "result": {
