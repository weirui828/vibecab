{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.StartSession.json",
  "title": "vcStartSessionOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "primaryProjectId": {
          "type": "string",
          "minLength": 1
        },
        "replyTrigger": {
          "enum": ["realtime", "batch", "manual"]
        },
        "ideaIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["sessionId"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.StartSession",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
