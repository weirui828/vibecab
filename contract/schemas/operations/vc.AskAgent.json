{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.AskAgent.json",
  "title": "vcAskAgentOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "threadIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["sessionId"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": { "turnId": { "type": "string", "minLength": 1 } },
      "required": ["turnId"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.AskAgent",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
