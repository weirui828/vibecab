{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.PauseSession.json",
  "title": "vcPauseSessionOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "paused"
        }
      },
      "required": [
        "sessionId",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "payload",
    "result"
  ],
  "additionalProperties": false,
  "operation": {
    "name": "vc.PauseSession",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": [
        "in_process",
        "http",
        "cli",
        "mcp"
      ]
    }
  }
}
