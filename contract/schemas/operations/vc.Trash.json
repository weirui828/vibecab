{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Trash.json",
  "title": "vcTrashOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["artifact", "session", "comment", "idea", "project"] },
            "id": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        }
      },
      "required": ["target"],
      "additionalProperties": false
    },
    "result": { "$ref": "https://vibecab.local/schemas/trash-record.json" }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Trash",
    "kind": "command",
    "meta": { "effect": "collaborate", "irreversible": false, "channels": ["in_process", "http", "cli", "mcp"] }
  }
}
