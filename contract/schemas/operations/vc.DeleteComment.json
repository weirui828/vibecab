{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.DeleteComment.json",
  "title": "vcDeleteCommentOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["commentId"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "minLength": 1
        },
        "deleted": {
          "const": true
        }
      },
      "required": ["commentId", "deleted"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.DeleteComment",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
