{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.EditDigest.json",
  "title": "vcEditDigestOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "whereItStands": { "type": "string" },
        "openQuestions": { "type": "array", "items": { "type": "string" } },
        "nextSteps": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["sessionId", "purpose", "whereItStands", "openQuestions", "nextSteps"],
      "additionalProperties": false
    },
    "result": { "$ref": "https://vibecab.local/schemas/session-digest.json" }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.EditDigest",
    "kind": "command",
    "meta": { "effect": "collaborate", "irreversible": false, "channels": ["in_process", "http", "cli", "mcp"] }
  }
}
