{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.ToolCalls.json",
  "title": "ToolCallsOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "result": {
      "type": "array",
      "items": {
        "$ref": "https://vibecab.local/schemas/tool-call.json"
      }
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.ToolCalls",
    "kind": "query",
    "meta": {
      "effect": "read",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
