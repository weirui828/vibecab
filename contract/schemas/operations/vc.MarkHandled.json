{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.MarkHandled.json",
  "title": "vcMarkHandledOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "commentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["commentIds"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "commentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["commentIds"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.MarkHandled",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
