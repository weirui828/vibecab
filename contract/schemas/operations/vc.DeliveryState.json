{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.DeliveryState.json",
  "title": "vcDeliveryStateOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "commentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["commentIds"],
      "additionalProperties": false
    },
    "result": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commentId": { "type": "string" },
          "state": {
            "enum": ["saved", "queued", "delivered", "replied", "handled"]
          },
          "turnId": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["commentId", "state", "updatedAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.DeliveryState",
    "kind": "query",
    "meta": {
      "effect": "read",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
