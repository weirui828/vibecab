{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/tmr.Submit.json",
  "title": "tmrSubmitOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "intendedUse": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "processSpec": { "type": "object" },
        "participants": { "type": "array", "items": { "type": "object" } },
        "limits": {
          "type": "object",
          "properties": { "spendMicros": { "type": "integer", "minimum": 0 }, "autoResume": { "type": "boolean" } },
          "required": ["spendMicros"],
          "additionalProperties": false
        },
        "mode": { "enum": ["live", "demo"] },
        "rerunOf": { "type": "string" }
      },
      "required": ["requestId", "question", "items", "criteria", "processSpec", "participants", "limits", "mode"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": { "runId": { "type": "string" }, "status": { "type": "string" } },
      "required": ["runId", "status"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "tmr.Submit",
    "kind": "command",
    "meta": { "effect": "collaborate", "irreversible": false, "channels": ["in_process", "http", "cli", "mcp"] }
  }
}
