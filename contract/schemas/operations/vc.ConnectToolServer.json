{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.ConnectToolServer.json",
  "title": "ConnectToolServerOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "stdio"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": ["kind", "command", "args"]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "http"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false,
              "required": ["kind", "url"]
            }
          ]
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "properties": {
            "sessionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "projectIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": ["name", "transport", "scope"]
    },
    "result": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string"
        },
        "status": {
          "const": "connecting"
        }
      },
      "additionalProperties": false,
      "required": ["serverId", "status"]
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.ConnectToolServer",
    "kind": "command",
    "meta": {
      "effect": "admin",
      "irreversible": false,
      "channels": ["in_process", "http", "cli"]
    }
  }
}
