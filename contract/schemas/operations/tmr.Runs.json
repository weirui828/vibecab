{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/tmr.Runs.json",
  "title": "tmrRunsOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": { "limit": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "result": { "type": "array", "items": { "$ref": "https://vibecab.local/schemas/tmr/run.json" } }
