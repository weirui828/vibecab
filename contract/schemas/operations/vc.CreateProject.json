{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.CreateProject.json",
  "title": "vcCreateProjectOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "ideaIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "artifactIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "sessionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "sourceSessionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["projectId"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.CreateProject",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
