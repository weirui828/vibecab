{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.HoldElement.json",
  "title": "vcHoldElementOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "artifactId": { "type": "string" },
        "elementId": { "type": "string" }
      },
      "required": ["artifactId", "elementId"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "artifactId": { "type": "string" },
        "elementId": { "type": "string" },
        "heldAt": { "type": "string", "format": "date-time" }
      },
      "required": ["artifactId", "elementId", "heldAt"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.HoldElement",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli"]
    }
  }
}
