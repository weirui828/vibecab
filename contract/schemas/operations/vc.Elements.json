{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Elements.json",
  "title": "vcElementsOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includeTrashed": { "type": "boolean" }
      },
      "required": ["artifactId"],
      "additionalProperties": false
    },
    "result": {
      "type": "array",
      "items": {
        "$ref": "https://vibecab.local/schemas/element.json"
      }
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Elements",
    "kind": "query",
    "meta": {
      "effect": "read",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
