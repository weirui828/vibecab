{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Comment.json",
  "title": "vcCommentOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "minLength": 1
            },
            "elementId": {
              "type": "string",
              "minLength": 1
            },
            "seenVersion": {
              "type": "integer",
              "minimum": 1
            },
            "locator": {
              "$ref": "https://vibecab.local/schemas/anchor.json#/properties/locator"
            }
          },
          "required": [
            "artifactId",
            "elementId",
            "seenVersion"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "suggestion": {
          "type": "object",
          "properties": {
            "replacement": {
              "type": "string"
            }
          },
          "required": [
            "replacement"
          ],
          "additionalProperties": false
        },
        "replyTo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sessionId",
        "body"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commentId",
        "threadId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "payload",
    "result"
  ],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Comment",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": [
        "in_process",
        "http",
        "cli",
        "mcp"
      ]
    }
  }
}
