{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/sys.UsageStats.json",
  "title": "sysUsageStatsOperation",
  "description": "Model calls between from (inclusive) and to (exclusive), totalled and grouped. Cost is what was settled, or what is still reserved for a call whose usage is unknown.",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "groupBy": {
          "enum": ["day", "agent", "model", "session", "purpose"]
        }
      },
      "required": ["from", "to", "groupBy"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "totals": {
          "type": "object",
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "costMicros": {
              "type": "integer",
              "minimum": 0
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "medianDurationMs": {
              "type": "integer",
              "minimum": 0
            },
            "p95DurationMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "calls",
            "costMicros",
            "inputTokens",
            "outputTokens",
            "cachedInputTokens",
            "errors",
            "medianDurationMs",
            "p95DurationMs"
          ],
          "additionalProperties": false
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "costMicros": {
                "type": "integer",
                "minimum": 0
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "cachedInputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              },
              "medianDurationMs": {
                "type": "integer",
                "minimum": 0
              },
              "p95DurationMs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "key",
              "calls",
              "costMicros",
              "inputTokens",
              "outputTokens",
              "cachedInputTokens",
              "errors",
              "medianDurationMs",
              "p95DurationMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["totals", "groups"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "sys.UsageStats",
    "kind": "query",
    "meta": {
      "effect": "read",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
