{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Digest.json",
  "title": "vcDigestOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": { "sessionId": { "type": "string", "minLength": 1 } },
      "required": ["sessionId"],
      "additionalProperties": false
    },
    "result": { "type": "array", "items": { "$ref": "https://vibecab.local/schemas/session-digest.json" } }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Digest",
    "kind": "query",
    "meta": { "effect": "read", "irreversible": false, "channels": ["in_process", "http", "cli", "mcp"] }
  }
}
