{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.EditComment.json",
  "title": "vcEditCommentOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "suggestion": {
          "type": "object",
          "properties": {
            "replacement": {
              "type": "string"
            }
          },
          "required": ["replacement"],
          "additionalProperties": false
        }
      },
      "required": ["commentId", "body"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["commentId"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.EditComment",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
