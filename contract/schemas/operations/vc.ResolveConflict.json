{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.ResolveConflict.json",
  "title": "vcResolveConflictOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "keep": {
          "type": "string",
          "minLength": 1
        },
        "supersede": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": ["keep", "supersede"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "conflictId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "resolved"
        }
      },
      "required": ["conflictId", "state"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.ResolveConflict",
    "kind": "command",
    "meta": {
      "effect": "collaborate",
      "irreversible": false,
      "channels": ["in_process", "http", "cli", "mcp"]
    }
  }
}
