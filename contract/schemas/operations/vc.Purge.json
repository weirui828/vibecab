{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Purge.json",
  "title": "vcPurgeOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["artifact", "session", "comment", "idea", "project"] },
            "id": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        "reviewActions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": { "type": "string", "minLength": 1 },
              "action": { "enum": ["redact", "delete"] }
            },
            "required": ["runId", "action"],
            "additionalProperties": false
          }
        }
      },
      "required": ["target"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": { "purgeId": { "type": "string" }, "status": { "const": "queued" } },
      "required": ["purgeId", "status"],
      "additionalProperties": false
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Purge",
    "kind": "command",
    "meta": { "effect": "admin", "irreversible": true, "channels": ["in_process", "http", "cli"] }
  }
}
