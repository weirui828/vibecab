{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/operations/vc.Artifacts.json",
  "title": "vcArtifactsOperation",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "includeTrashed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "mediaKind": { "enum": ["doc", "html"] },
          "headVersion": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "sessionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "role": { "enum": ["primary", "reference"] }
        },
        "required": ["artifactId", "title", "mediaKind", "headVersion", "createdAt", "updatedAt", "sessionIds"],
        "additionalProperties": false
      }
    }
  },
  "required": ["payload", "result"],
  "additionalProperties": false,
  "operation": {
    "name": "vc.Artifacts",
    "kind": "query",
    "meta": { "effect": "read", "irreversible": false, "channels": ["in_process", "http", "cli", "mcp"] }
  }
}
