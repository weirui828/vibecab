{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/update-write.json",
  "title": "UpdateWrite",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "https://vibecab.local/schemas/commit-input.json#/properties/changes/items"
      }
    },
    "itemResults": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "status": { "const": "addressed" },
              "elementIds": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "required": ["itemId", "status", "elementIds"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "status": { "const": "not_addressed" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["itemId", "status", "reason"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["changes", "itemResults"],
  "additionalProperties": false
}
