{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/tool-call.json",
  "title": "ToolCall",
  "type": "object",
  "properties": {
    "callId": {
      "type": "string",
      "minLength": 1
    },
    "turnId": {
      "type": "string",
      "minLength": 1
    },
    "serverId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "argsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestBytes": {
      "type": "integer",
      "minimum": 0
    },
    "resultBytes": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": ["success", "error", "timeout"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": ["callId", "turnId", "serverId", "tool", "argsHash", "requestBytes", "durationMs", "outcome", "createdAt"]
}
