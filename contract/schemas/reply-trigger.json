{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecab.local/schemas/reply-trigger.json",
  "title": "ReplyTrigger",
  "type": "object",
  "properties": {
    "mode": { "enum": ["realtime", "batch", "manual"] },
    "batch": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "idleMinutes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "required": ["mode"],
  "additionalProperties": false
}
